# Copy this file to .env for local development. Never commit .env.
# On the live site these are set in the hosting provider's settings, not in a file.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://app.example.org (only needed in production)
DJANGO_CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://osea:osea@localhost:5432/osea

# Email. Leave the backend unset to print emails to the terminal instead of sending.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=OSEA <no-reply@example.org>

# Shown as a banner so testers know they're not on the real site. Leave empty in production.
OSEA_ENVIRONMENT_LABEL=Development

# Two-step sign-in is required for administrators on the live site. Turn it off only for
# local development and demos with fictional data.
OSEA_REQUIRE_ADMIN_2FA=false

# Behind the hosting provider's proxy: the header with the visitor's real address
# (DigitalOcean: HTTP_DO_CONNECTING_IP). Leave empty locally.
OSEA_CLIENT_IP_HEADER=
